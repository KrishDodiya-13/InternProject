# --- PostgreSQL container (read by docker compose) ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=document_vault
# Host port for the container. 5433 avoids clashing with a native PostgreSQL
# install that may already own 5432. The container always listens on 5432.
POSTGRES_PORT=5433

# --- Application ---
# Prisma connection string. Must match the POSTGRES_* values above.
DATABASE_URL="postgresql://vault:vault@localhost:5433/document_vault?schema=public"

# Port the GraphQL Yoga server listens on.
PORT=4000
